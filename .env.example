# =====================================================================
#  Discord Voice AI  configuration
#  Copy this file to ".env" and fill in the required values.
# =====================================================================

# ===== Discord (required) =====
# Your bot token and application ID from the Discord Developer Portal.
DISCORD_TOKEN=your-bot-token
DISCORD_ID=your-application-id

# ===== Which AI answers (required) =====
# "openai" uses GPT models, "anthropic" uses Claude models.
# Speech to text and text to speech always use OpenAI, so an OpenAI key is
# required for voice even when the provider is anthropic.
LLM_PROVIDER=openai

# OpenAI key: powers voice (speech to text and text to speech) and the LLM
# when the provider is openai. Get one at platform.openai.com.
OPENAI_API_KEY=your-openai-key

# Anthropic key: only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-key

# ===== Models (optional) =====
# The chat model each provider uses.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
# Speech models (always OpenAI). TTS_VOICE is one of OpenAI's named voices.
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy

# ===== Voice behaviour (optional) =====
# Wake words: say one of these to get the bot's attention (comma separated).
BOT_TRIGGERS=Assistant,Bot
# Say one of these while it is talking to make it stop (comma separated).
STOP_WORDS=stop
# Silence in milliseconds before it decides you are done talking. Raise it if it cuts you off.
WAIT_TIME=1500
# Set to true to let it react out loud to images you post.
VISION=true

# ===== Personality (optional) =====
# One line that shapes how the bot behaves in every mode (tone, verbosity, style).
# Voice replies are kept free of formatting automatically since they are spoken,
# and text replies can use Markdown. Everything else is up to this prompt.
SYSTEM_PROMPT=You are a helpful, friendly assistant. If you do not know the answer, just say so.
