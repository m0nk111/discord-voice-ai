# =====================================================================
#  Discord Voice AI  configuration
#  Copy this file to ".env" and fill in the required values.
# =====================================================================

# ===== Discord (required) =====
# Your bot token and application ID from the Discord Developer Portal.
DISCORD_TOKEN=your-bot-token
DISCORD_ID=your-application-id

# ===== Which AI answers (required) =====
# "openai" uses GPT models, "anthropic" uses Claude models.
# Speech to text and text to speech always use the OPENAI_BASE_URL endpoint,
# so an OpenAI-style key is required for voice even when the provider is
# anthropic.
LLM_PROVIDER=openai

# OpenAI-style key: powers voice (speech to text and text to speech) and the
# LLM when the provider is openai. With a self-hosted gateway this is the
# gateway's API key. For OpenAI cloud, get one at platform.openai.com.
OPENAI_API_KEY=your-openai-key

# OpenAI-compatible base URL used for STT, TTS and the LLM. Point this at a
# self-hosted gateway, e.g. the guardian gateway (default: OpenAI cloud).
#OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Anthropic key: only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-key

# ===== Models (optional) =====
# The chat model each provider uses. With a self-hosted gateway this must be a
# model the gateway serves (e.g. qwen3.5-9b on guardian).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5
# Speech models (always via OPENAI_BASE_URL). TTS_VOICE is one of OpenAI's
# named voices (alloy, nova, ...) — guardian maps these to voice instructions.
# Optional: dedicated cloud STT endpoint (e.g. Groq's OpenAI-compatible API),
# so transcription uses a different engine than TTS/LLM:
#STT_BASE_URL=https://api.groq.com/openai/v1
#STT_API_KEY=your-groq-key
# With a dedicated STT endpoint pick a model it serves, e.g.
# STT_MODEL=whisper-large-v3-turbo
STT_MODEL=whisper-1
STT_LANG=
TTS_MODEL=tts-1
TTS_VOICE=alloy
# TTS response format. Guardian serves "wav" or "pcm"; OpenAI also takes "mp3".
TTS_FORMAT=wav

# ===== Voice behaviour (optional) =====
# Wake words: say one of these to get the bot's attention (comma separated).
BOT_TRIGGERS=Assistant,Bot
# Say one of these while it is talking to make it stop (comma separated).
STOP_WORDS=stop
# Silence in milliseconds before it decides you are done talking. Raise it if it cuts you off.
WAIT_TIME=1500
# Set to true to let it react out loud to images you post.
VISION=true

# ===== Personality (optional) =====
# One line that shapes how the bot behaves in every mode (tone, verbosity, style).
# Voice replies are kept free of formatting automatically since they are spoken,
# and text replies can use Markdown. Everything else is up to this prompt.
SYSTEM_PROMPT=You are a helpful, friendly assistant. If you do not know the answer, just say so.
